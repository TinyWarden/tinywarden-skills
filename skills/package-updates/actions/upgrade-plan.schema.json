{
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "upgrade_packages"
      ],
      "maxLength": 32
    },
    "command_policy": {
      "type": "string",
      "enum": [
        "plain-upgrade-v1"
      ],
      "maxLength": 32
    },
    "package_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5000
    },
    "kept_back_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "packages": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 4096
          },
          "installed_version": {
            "type": "string",
            "maxLength": 4096
          },
          "candidate_version": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "required": [
          "name",
          "installed_version",
          "candidate_version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "operation",
    "command_policy",
    "package_count",
    "kept_back_count",
    "packages"
  ],
  "additionalProperties": false
}
